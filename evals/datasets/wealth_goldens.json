  "test_cases": [
    {
      "id": "wealth_001",
      "name": "Risk Tolerance Change - Properly Grounded",
      "description": "Correctly formatted memo for client risk tolerance change",
      "expected_result": "pass",
      "memo": {
        "decision_id": "dec_risk_001",
        "title": "Client Risk Profile Update - Smith Family Trust",
        "sections": [
          {
            "heading": "Situation",
            "claims": [
              {
                "text": "Client requested change from Aggressive to Moderate risk profile on January 5, 2025",
                "evidence_refs": [
                  {"evidence_id": "sig_risk_001", "evidence_type": "signal"}
                ]
              },
              {
                "text": "Current portfolio allocation is 80% equities, 15% fixed income, 5% alternatives",
                "evidence_refs": [
                  {"evidence_id": "sig_alloc_001", "evidence_type": "signal"}
                ]
              },
              {
                "text": "The Moderate profile requires maximum 60% equity allocation per IPS guidelines",
                "evidence_refs": [
                  {"evidence_id": "pol_ips_001", "evidence_type": "policy"}
                ]
              }
            ]
          },
          {
            "heading": "Policy Evaluation",
            "claims": [
              {
                "text": "Governance kernel identified 20% equity over-allocation requiring rebalance",
                "evidence_refs": [
                  {"evidence_id": "eval_risk_001", "evidence_type": "evaluation"}
                ]
              }
            ]
          },
          {
            "heading": "Options Presented",
            "claims": [
              {
                "text": "Option A: Immediate rebalance to 60/35/5 allocation",
                "evidence_refs": [
                  {"evidence_id": "opt_risk_001a", "evidence_type": "option"}
                ]
              },
              {
                "text": "Option B: Phased rebalance over 90 days to minimize tax impact",
                "evidence_refs": [
                  {"evidence_id": "opt_risk_001b", "evidence_type": "option"}
                ]
              }
            ]
          },
          {
            "heading": "Decision",
            "claims": [
              {
                "text": "Advisor selected Option B for phased rebalance",
                "evidence_refs": [
                  {"evidence_id": "opt_risk_001b", "evidence_type": "chosen_option"},
                  {"evidence_id": "dec_risk_001", "evidence_type": "decision"}
                ]
              }
            ]
          }
        ]
      },
      "evidence_pack": {
        "evidence_pack_id": "evp_risk_001",
        "evidence_items": [
          {
            "evidence_id": "sig_risk_001",
            "type": "signal",
            "data": {
              "signal_type": "risk_tolerance_change",
              "client_id": "smith_family_trust",
              "previous_profile": "aggressive",
              "requested_profile": "moderate",
              "request_date": "2025-01-05"
            }
          },
          {
            "evidence_id": "sig_alloc_001",
            "type": "signal",
            "data": {
              "signal_type": "portfolio_allocation",
              "equities_pct": 80,
              "fixed_income_pct": 15,
              "alternatives_pct": 5
            }
          },
          {
            "evidence_id": "pol_ips_001",
            "type": "policy",
            "data": {
              "name": "Investment Policy Statement",
              "moderate_profile": {
                "max_equity_pct": 60,
                "min_fixed_income_pct": 30
              }
            }
          },
          {
            "evidence_id": "eval_risk_001",
            "type": "evaluation",
            "data": {
              "result": "breach",
              "equity_over_allocation_pct": 20
            }
          },
          {
            "evidence_id": "opt_risk_001a",
            "type": "option",
            "data": {
              "label": "Immediate rebalance to 60/35/5",
              "implications": ["Potential tax event", "Same-day execution"]
            }
          },
          {
            "evidence_id": "opt_risk_001b",
            "type": "option",
            "data": {
              "label": "Phased rebalance over 90 days",
              "implications": ["Tax-loss harvesting opportunity", "Gradual transition"]
            }
          },
          {
            "evidence_id": "dec_risk_001",
            "type": "decision",
            "data": {
              "chosen_option": "opt_risk_001b",
              "decided_by": "advisor_jones"
            }
          }
        ]
      }
    },
