          "constraint_id": "kid_required",
          "metric_id": "kid_on_file",
          "operator": "==",
          "threshold": 1,
          "measured": 0,
          "value_date": "2026-02-17",
          "currency": null,
          "flags": ["MISSING_REQUIRED_DOC"],
          "evidence_refs": [{ "doc_id": "portfolio_export", "ref": "KID missing for AXN Autocall" }]
        }
      ],
      "expected": { "before_breach_count": 1, "after_breach_count": 0 },
      "notes": ["Expected after: POLICY_BLOCKER_MISSING_DOC (non-breach)."]
    },
    {
      "scenario_id": "W05_FEE_DISCREPANCY_NOT_BREACH",
