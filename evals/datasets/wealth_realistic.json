{
  "pack": "wealth",
  "version": "2.0.0",
  "description": "Realistic wealth management signal fixtures with rich structure. Tests lookthrough gating, definition disputes, cross-type dedup, and signal type misclassification.",
  "scenarios": [
    {
      "scenario_id": "W01_TRUE_CONCENTRATION_BREACH",
      "title": "Single fund concentration breach should remain breach",
      "domain": "wealth",
      "description": "OakRidge weight exceeds max single fund cap; complete fields -> breach remains.",
      "input_signals": [
        {
          "id": "w01_s1",
          "source": "ic_memo",
          "proposed_type": "position_limit_breach",
          "subject": { "id": "fund_oakridge_pcf_iii", "name": "OakRidge Private Credit Fund III", "type": "fund" },
          "constraint_id": "max_single_fund_15pct",
          "metric_id": "pct_of_tpv",
          "operator": ">",
          "threshold": 0.15,
          "measured": 0.176,
          "value_date": "2026-02-18",
          "currency": null,
          "flags": ["METRIC_DEFINITION_KNOWN", "VALUE_DATE_CONFIRMED"],
          "evidence_refs": [{ "doc_id": "ic_memo_2026-02-18", "ref": "OakRidge 17.6%" }]
        }
      ],
      "expected": { "before_breach_count": 1, "after_breach_count": 1 },
      "notes": ["Expected after: CONCENTRATION_BREACH."]
    },
    {
      "scenario_id": "W02_LOOKTHROUGH_MISSING_NOT_BREACH",
      "title": "Look-through-required constraint cannot be breach without look-through",
      "domain": "wealth",
      "description": "EM ETF weight 11.4% is not proof that any single country >10%. Should downgrade to LOOKTHROUGH_MISSING.",
      "input_signals": [
        {
          "id": "w02_s1",
          "source": "ic_memo",
          "proposed_type": "position_limit_breach",
          "subject": { "id": "etf_em_equity", "name": "EM Equity ETF", "type": "fund" },
          "constraint_id": "max_single_country_em_10pct",
          "metric_id": "single_country_em_exposure_pct",
          "operator": ">",
          "threshold": 0.1,
          "measured": 0.114,
          "value_date": "2026-02-18",
          "currency": null,
          "flags": ["LOOKTHROUGH_REQUIRED", "LOOKTHROUGH_MISSING"],
          "evidence_refs": [{ "doc_id": "ic_memo_2026-02-18", "ref": "EM ETF 11.4% (country breakdown missing)" }]
        }
      ],
      "expected": { "before_breach_count": 1, "after_breach_count": 0 },
      "notes": ["Expected after: LOOKTHROUGH_MISSING (non-breach)."]
    },
    {
      "scenario_id": "W03_LIQUIDITY_DEFINITION_DISPUTE",
      "title": "Liquidity runway depends on definition; treat as dispute/risk, not breach",
      "domain": "wealth",
      "description": "Internal cash differs from custodian cash (pending settlement). Mandate says 12m liquidity; CIO says liquid assets count.",
      "input_signals": [
        {
          "id": "w03_s1",
          "source": "ic_memo",
          "proposed_type": "mandate_breach",
          "subject": { "id": "client_karmine", "name": "Karmine Holdings SA", "type": "client" },
          "constraint_id": "liquidity_12_months",
          "metric_id": "cash_available_usd",
          "operator": "<",
          "threshold": 1200000,
          "measured": 640000,
          "value_date": "2026-02-18",
          "currency": "USD",
          "flags": ["DEFINITION_DISPUTE", "SOURCE_CONFLICT"],
          "evidence_refs": [{ "doc_id": "ic_memo_2026-02-18", "ref": "cash 640k; annual spend 1.2m" }]
        },
        {
          "id": "w03_s2",
          "source": "custodian_scan",
          "proposed_type": "mandate_breach",
          "subject": { "id": "client_karmine", "name": "Karmine Holdings SA", "type": "client" },
          "constraint_id": "liquidity_12_months",
          "metric_id": "cash_available_usd",
          "operator": "<",
          "threshold": 1200000,
          "measured": 1240110.1,
          "value_date": "2026-02-14",
          "currency": "USD",
          "flags": ["VALUE_DATE_MISMATCH", "PENDING_SETTLEMENT_INCLUDED"],
          "evidence_refs": [{ "doc_id": "custodian_scan_2026-02-14", "ref": "cash 1.24m incl pending settlement 580k" }]
        }
      ],
      "expected": { "before_breach_count": 2, "after_breach_count": 0 },
      "notes": ["Expected after: LIQUIDITY_DEFINITION_DISPUTE + SETTLEMENT_PENDING_CASH / RECONCILIATION_VARIANCE (non-breach)."]
    },
    {
      "scenario_id": "W04_MISSING_KID_BLOCKER",
      "title": "Missing PRIIPs/KID should be a blocker, not breach",
      "domain": "wealth",
      "description": "Structured note present but KID missing; initial 'compliance breach' should become POLICY_BLOCKER_MISSING_DOC.",
      "input_signals": [
        {
          "id": "w04_s1",
