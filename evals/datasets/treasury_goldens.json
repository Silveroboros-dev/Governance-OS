{
  "version": "1.0.0",
  "pack": "treasury",
  "description": "Golden test cases for treasury domain narrative memos",
  "test_cases": [
    {
      "id": "treasury_001",
      "name": "Position Limit Breach - Properly Grounded",
      "description": "Correctly formatted memo for BTC position limit breach",
      "expected_result": "pass",
      "memo": {
        "decision_id": "dec_pos_001",
        "title": "BTC Position Limit Breach Resolution",
        "sections": [
          {
            "heading": "Situation",
            "claims": [
              {
                "text": "The BTC position reached $152.3M at 14:32 UTC on 2025-01-15",
                "evidence_refs": [
                  {"evidence_id": "sig_pos_001", "evidence_type": "signal"}
                ]
              },
              {
                "text": "This exceeds the $100M single-asset limit defined in the Position Limits Policy v2.1",
                "evidence_refs": [
                  {"evidence_id": "pol_pos_001", "evidence_type": "policy"},
                  {"evidence_id": "eval_pos_001", "evidence_type": "evaluation"}
                ]
              }
            ]
          },
          {
            "heading": "Options Presented",
            "claims": [
              {
                "text": "Option A: Reduce position to $95M within 4 hours",
                "evidence_refs": [
                  {"evidence_id": "opt_pos_001a", "evidence_type": "option"}
                ]
              },
              {
                "text": "Option B: Request temporary limit increase to $175M pending review",
                "evidence_refs": [
                  {"evidence_id": "opt_pos_001b", "evidence_type": "option"}
                ]
              }
            ]
          },
          {
            "heading": "Decision",
            "claims": [
              {
                "text": "The decision-maker selected Option A to reduce the position",
                "evidence_refs": [
                  {"evidence_id": "opt_pos_001a", "evidence_type": "chosen_option"}
                ]
              },
              {
                "text": "Rationale documented: favorable market conditions for liquidation",
                "evidence_refs": [
                  {"evidence_id": "dec_pos_001", "evidence_type": "decision"}
                ]
              }
            ]
          }
        ]
      },
      "evidence_pack": {
        "evidence_pack_id": "evp_pos_001",
        "evidence_items": [
          {
            "evidence_id": "sig_pos_001",
            "type": "signal",
            "data": {
              "signal_type": "position_breach",
              "asset": "BTC",
              "current_value_usd": 152300000,
              "limit_usd": 100000000,
              "breach_percentage": 52.3,
              "timestamp": "2025-01-15T14:32:00Z"
            }
          },
          {
            "evidence_id": "pol_pos_001",
            "type": "policy",
            "data": {
              "name": "Position Limits Policy",
              "version": "2.1",
              "single_asset_limit_usd": 100000000
            }
          },
          {
            "evidence_id": "eval_pos_001",
            "type": "evaluation",
            "data": {
              "result": "breach",
              "severity": "high",
              "breach_amount_usd": 52300000
            }
          },
          {
            "evidence_id": "opt_pos_001a",
            "type": "option",
            "data": {
              "label": "Reduce position to $95M within 4 hours",
              "implications": ["Market impact ~0.5%", "Immediate compliance"]
            }
          },
          {
            "evidence_id": "opt_pos_001b",
            "type": "option",
            "data": {
              "label": "Request temporary limit increase to $175M",
              "implications": ["Requires CRO approval", "24-48 hour process"]
            }
          },
          {
            "evidence_id": "dec_pos_001",
            "type": "decision",
            "data": {
              "chosen_option": "opt_pos_001a",
              "rationale": "Favorable market conditions for liquidation",
              "decided_by": "treasury_head"
            }
          }
        ]
      }
    },
